# =============================================================================
# BANGLADESHI NEWS PORTAL — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# Only variables prefixed NEXT_PUBLIC_ are safe to expose to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon Serverless PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# AUTHENTICATION (Better Auth)
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=your-32-char-minimum-random-secret-here
BETTER_AUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (optional — leave blank to disable)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 MEDIA STORAGE
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=news-media
# Required for uploads: the browser-accessible HTTPS URL of the R2 bucket/CDN.
# next.config.ts derives the allowed image hostname from this URL at build time.
R2_PUBLIC_URL=https://media.yourdomain.com

# -----------------------------------------------------------------------------
# EMAIL (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# CACHE & RATE LIMITING (Upstash Redis)
# Not required for login or password-reset throttling (Better Auth uses memory).
# Still required for production search and article-view requests.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# ERROR MONITORING (Sentry)
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# CRON JOB SECURITY
# Use a long random string. Set the same value in Vercel Cron config.
# -----------------------------------------------------------------------------
CRON_SECRET=your-cron-secret-here

# -----------------------------------------------------------------------------
# SUPER ADMIN BOOTSTRAP
# Used only once to create the first admin account via /api/bootstrap.
# Remove or leave blank after bootstrap is complete.
# -----------------------------------------------------------------------------
# Generate a random value of at least 32 characters, or leave blank to disable.
ADMIN_BOOTSTRAP_SECRET=

# -----------------------------------------------------------------------------
# PUBLIC VARIABLES (safe for browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=বাংলা নিউজ
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-xxxxxxxxxx
